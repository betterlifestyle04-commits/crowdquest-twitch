# Root configuration, loaded only by the Node server. Never expose these through Vite variables.
NODE_ENV=development
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
# Comma-separated approved frontend origins
WEB_ORIGIN=http://localhost:5173
PORT=3001
# Required in production. In development it protects dashboard controls when set.
# Create a long random value, e.g. `openssl rand -hex 32`; never commit it.
STREAMER_CONTROL_TOKEN=
